{
  "name": "bacs-file-data-generator",
  "version": "0.0.0-dev",
  "description": "Domain library for generating BACS style test data (EaziPay, SDDirect, Bacs18PaymentLines)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run lint && npx prettier --check .",
    "test": "vitest run -c ./vitest.config.ts",
    "test:coverage": "vitest run -c ./vitest.config.ts --coverage",
    "lint": "eslint . --ext .ts",
    "dev-server": "node --loader ts-node/esm src/server.ts",
    "start:generator": "node dist/server.js"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "@fastify/multipart": "9.3.0",
    "fastify": "^5.6.2",
    "lts": "^2.0.0",
    "luxon": "^3.5.0",
    "pino": "^9.0.0",
    "xmlbuilder2": "4.0.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.3.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0",
    "vitest": "^4.0.14"
  }
}
